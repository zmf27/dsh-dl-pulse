{
    "name":  "dsh-dl-pulse",
    "version":  "0.1.1",
    "description":  "DSH Web GUI 瀹炴椂涓嬭浇杩涘害锛氳緭鍏ユ宸︿晶绾枃瀛楁樉绀?~/.dsh/downloads/ 涓嬬殑涓嬭浇杩涘害锛坒s.watch + SSE 鎺ㄩ€侊紝浜嬩欢椹卞姩闆惰疆璇級",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ],
                               "platform":  "web"
                           }
            },
    "scripts":  {
                    "build":  "tsc -b \u0026\u0026 tsdown",
                    "prepare":  "tsdown",
                    "watch":  "tsdown --watch",
                    "test":  "vitest run",
                    "typecheck":  "tsc -b --pretty false"
                },
    "peerDependencies":  {
                             "react":  "^18.2.0"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "@deepseek-ai/dsh-client-locale":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-runtime":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-ui-conversation":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-ui-slots":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-host-webserver":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-system-prompt":  "^0.1.0-rc.6",
                            "@types/node":  "^22.20.0",
                            "@types/react":  "~18.3.1",
                            "jsdom":  "29.1.1",
                            "lightningcss":  "^1.32.0",
                            "react":  "^18.3.1",
                            "tsdown":  "0.22.2",
                            "typescript":  "~5.7.2",
                            "vitest":  "^4.1.8"
                        },
    "files":  [
                  "lib",
                  "src",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "license":  "BSD-3-Clause",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/zmf27/dsh-dl-pulse.git"
                   }
}
